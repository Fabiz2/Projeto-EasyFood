# Copie este arquivo para .env e preencha os valores

# Banco MySQL
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/easyfood"

# JWT
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# E-mail: SendPulse (chave "sp_...", em Configurações > API) ou Resend (chave "re_...")
# O provedor é detectado pelo prefixo da chave
EMAIL_API_KEY="sp_apikey_sua_chave_aqui"
# Remetente: um e-mail cadastrado como remetente na sua conta
EMAIL_FROM="seu-email@exemplo.com"
EMAIL_FROM_NAME="EasyFood"
# Para quem os e-mails de teste vão
EMAIL_TEST_TO="seu-email@exemplo.com"
